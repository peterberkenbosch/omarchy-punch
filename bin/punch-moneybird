#!/bin/bash

# Pushes finished Punch entries to Moneybird through the official
# moneybird-cli. Kept out of the shell as a plain script so a sync that goes
# wrong can be run, read, and argued with from a terminal instead of from
# inside a QML service.
#
# Contract with the service:
#   stdin   a JSON array of entries: [{id, project, note, start, end}, ...]
#           (or a file holding the same, passed as `push <file>`)
#   stdout  a JSON array of results: [{id, moneybirdId, skipped, error}, ...]
#   exit    0 when the run completed (per-entry failures ride in the results),
#           non-zero only when nothing could be attempted at all.
#
# The service owns entries.jsonl and is the only writer; this script never
# touches it. It reports what happened and lets the service record it.

set -uo pipefail

CONFIG="${PUNCH_MONEYBIRD_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/punch/moneybird.json}"
CLI="${PUNCH_MONEYBIRD_CLI:-moneybird-cli}"

# Moneybird rounds timestamps down to whole minutes and demands at least one
# minute between them, so anything shorter can never be represented there.
MIN_SECONDS=60

die() {
  echo "$1" >&2
  exit 1
}

usage() {
  cat <<'USAGE'
Usage: punch-moneybird <command>

  push [file] push entries read from stdin (or from a file), report results
  doctor      check login, resolve the user, and show how projects would map
  contacts    list Moneybird contacts (id and name)
  projects    list Moneybird projects (id and name)

Configuration lives in ~/.config/punch/moneybird.json:

  {
    "userId": "",
    "defaultBillable": true,
    "projects": {
      "admin":    { "billable": false },
      "acme-web": { "project": "Acme website", "contact": "Acme Corp" }
    }
  }

A Punch project with no entry here is matched against Moneybird projects by
name. Set "project" to null to send the entry with no project attached.
USAGE
}

require_cli() {
  command -v "$CLI" >/dev/null 2>&1 ||
    die "moneybird-cli is not on PATH. Install it: curl -fsSL https://raw.githubusercontent.com/moneybird/moneybird-cli/main/install.sh | bash"
  command -v jq >/dev/null 2>&1 || die "jq is required"
  # `administration current` only reads local config, so it says "logged in"
  # for a token the API has since rejected. Whether the token still works is
  # a question only the API can answer.
  "$CLI" administration current >/dev/null 2>&1 ||
    die "moneybird-cli is not logged in. Run: moneybird-cli login <token>"
}

# Every API read goes through here so a failure arrives as the reason it
# happened rather than as an empty list. moneybird-cli reports auth trouble on
# stdout and can still exit 0, so the text has to be inspected as well.
api() {
  local out status
  out=$("$CLI" "$@" --output raw 2>&1)
  status=$?
  if ((status != 0)) || [[ $out == Error:* ]]; then
    local reason
    reason=$(tr '\n' ' ' <<<"$out" | sed 's/  */ /g' | cut -c1-220)
    case "$reason:$1" in
    # Moneybird answers 401 both for a token it does not know and for one that
    # is fine but not allowed here, and moneybird-cli reports them
    # identically. Users and projects live behind `settings`, so a token that
    # can happily write time entries still cannot read the two lists needed to
    # decide where they go.
    *"Authentication failed"*:users | *"Authentication failed"*:projects | *"refresh token"*:users | *"refresh token"*:projects)
      die "Moneybird refused to list $1. A personal token needs the 'settings' scope to read users and projects, alongside 'time_entries' and 'sales_invoices'. Create a new token with all three and run: moneybird-cli login <token>" ;;
    *"Authentication failed"* | *"refresh token"*)
      die "Moneybird rejected the token. Create a new one under Settings > External applications and AI connections, then: moneybird-cli login <token>" ;;
    *) die "moneybird-cli $1 $2 failed: $reason" ;;
    esac
  fi
  printf '%s' "$out"
}

config_json() {
  if [[ -f $CONFIG ]]; then
    jq '.' "$CONFIG" 2>/dev/null || die "$CONFIG is not valid JSON"
  else
    echo '{}'
  fi
}

# The token belongs to one user, but the API only offers the whole list, so
# fall back to the single real person when there is exactly one. Anything
# ambiguous is the user's call, not a guess this script should make.
resolve_user_id() {
  local configured
  configured=$(config_json | jq -r '.userId // "" | tostring')
  if [[ -n $configured && $configured != "null" ]]; then
    echo "$configured"
    return 0
  fi

  local users count
  users=$(api users list)
  count=$(jq '[.[] | select((.permissions // []) | index("time_entries"))] | length' <<<"$users" 2>/dev/null)
  if [[ ${count:-0} == 1 ]]; then
    jq -r '[.[] | select((.permissions // []) | index("time_entries"))][0].id' <<<"$users"
    return 0
  fi
  count=$(jq 'length' <<<"$users" 2>/dev/null)
  if [[ ${count:-0} == 1 ]]; then
    jq -r '.[0].id' <<<"$users"
    return 0
  fi
  return 1
}

fetch_projects() {
  api projects list
}

find_contact_id() {
  local name="$1"
  [[ -n $name ]] || return 1
  api contacts list --query "$name" |
    jq -r --arg n "$name" '
      [ .[] | select(((.company_name // "") | ascii_downcase) == ($n | ascii_downcase)
                  or (((.firstname // "") + " " + (.lastname // "")) | ltrimstr(" ") | rtrimstr(" ") | ascii_downcase) == ($n | ascii_downcase)) ]
      | if length > 0 then .[0].id else empty end'
}

case "${1:-}" in
-h | --help | help | "")
  usage
  exit 0
  ;;
contacts)
  require_cli
  api contacts list | jq -r '.[] | "\(.id)\t\(.company_name // ((.firstname // "") + " " + (.lastname // "")))"'
  exit 0
  ;;
projects)
  require_cli
  fetch_projects | jq -r '.[] | "\(.id)\t\(.name)\t\(.state)"'
  exit 0
  ;;
doctor)
  require_cli
  echo "administration: $("$CLI" administration current 2>&1 | head -1)"

  # Which endpoints the token may read, one line each. A token can be
  # perfectly valid and still be missing exactly the scope this needs, and
  # that difference is invisible in the error moneybird-cli passes on.
  echo
  echo "Access:"
  scope_missing=0
  for resource in contacts time_entries projects users; do
    if "$CLI" "$resource" list --output raw >/dev/null 2>&1; then
      printf '  %-14s ok\n' "$resource"
    else
      printf '  %-14s no\n' "$resource"
      [[ $resource == projects || $resource == users ]] && scope_missing=1
    fi
  done
  if ((scope_missing)); then
    echo
    echo "Punch needs to read projects and users to decide where time goes." >&2
    echo "Those live behind Moneybird's 'settings' scope. Create a token with" >&2
    echo "'settings', 'time_entries', and 'sales_invoices', then log in again." >&2
    exit 1
  fi
  echo
  # Proves the token before reporting anything that depends on it, so a dead
  # token reads as a dead token instead of an account with no projects.
  api users list >/dev/null
  if user_id=$(resolve_user_id); then
    echo "user id:        $user_id"
  else
    echo "user id:        UNRESOLVED — more than one candidate; set \"userId\" in $CONFIG"
    echo
    echo "Users who can track time:"
    api users list | jq -r '.[] | select((.permissions // []) | index("time_entries")) | "  \(.id)  \(.name // .email // "?")"'
  fi
  echo "config:         $CONFIG$([[ -f $CONFIG ]] || echo ' (missing, defaults apply)')"
  echo
  echo "Moneybird projects:"
  fetch_projects | jq -r '.[] | "  \(.name)  [\(.state)]"'
  exit 0
  ;;
push) ;;
*)
  usage >&2
  exit 1
  ;;
esac

# ---------------------------------------------------------------- push

require_cli

# Prove the token before anything else runs. resolve_user_id and the mapping
# lookups all happen inside command substitutions, where `die` only kills the
# subshell — so an auth failure discovered down there surfaced twice: once as
# itself, and once as whatever the caller made of the empty result.
api users list >/dev/null

if [[ -n ${2:-} ]]; then
  [[ -f $2 ]] || die "no such file: $2"
  entries=$(cat "$2")
else
  entries=$(cat)
fi
[[ -n $entries ]] || { echo '[]'; exit 0; }
jq -e 'type == "array"' >/dev/null 2>&1 <<<"$entries" || die "expected a JSON array of entries on stdin"
count=$(jq 'length' <<<"$entries")
[[ $count -gt 0 ]] || { echo '[]'; exit 0; }

user_id=$(resolve_user_id) ||
  die "could not work out which Moneybird user to book time for. Set \"userId\" in $CONFIG (see: punch-moneybird doctor)."

config=$(config_json)
default_billable=$(jq -r 'if .defaultBillable == false then "false" else "true" end' <<<"$config")
projects_json=$(fetch_projects)

declare -A CONTACT_CACHE

results="[]"
for ((i = 0; i < count; i++)); do
  entry=$(jq -c ".[$i]" <<<"$entries")
  id=$(jq -r '.id' <<<"$entry")
  punch_project=$(jq -r '.project' <<<"$entry")
  note=$(jq -r '.note // ""' <<<"$entry")
  start=$(jq -r '.start' <<<"$entry")
  end=$(jq -r '.end' <<<"$entry")

  add_result() {
    results=$(jq -c --arg id "$id" --arg mb "${1:-}" --argjson skipped "${2:-false}" --arg err "${3:-}" \
      '. + [{id: $id, moneybirdId: (if $mb == "" then null else $mb end), skipped: $skipped, error: (if $err == "" then null else $err end)}]' \
      <<<"$results")
  }

  if ((end - start < MIN_SECONDS)); then
    add_result "" true "shorter than the minute Moneybird can represent"
    continue
  fi

  mapping=$(jq -c --arg p "$punch_project" '.projects[$p] // {}' <<<"$config")
  billable=$(jq -r --arg d "$default_billable" 'if has("billable") then (.billable | tostring) else $d end' <<<"$mapping")

  # An explicit null means "book this without a project"; anything else falls
  # back to matching the Punch project name against Moneybird's.
  #
  # A name that matches nothing is refused rather than booked bare. Sending it
  # anyway would put billable time against no project at all, which is the
  # kind of thing you find out about on an invoice. Refusing leaves the entry
  # queued and complaining until it is mapped, which is the whole point of
  # having a mapping file.
  project_id=""
  if jq -e 'has("project") and .project == null' >/dev/null <<<"$mapping"; then
    project_id=""
  else
    project_name=$(jq -r --arg p "$punch_project" '.project // $p' <<<"$mapping")
    project_id=$(jq -r --arg n "$project_name" \
      '[ .[] | select((.name // "" | ascii_downcase) == ($n | ascii_downcase)) ] | if length > 0 then .[0].id else "" end' \
      <<<"$projects_json")
    if [[ -z $project_id ]]; then
      add_result "" false "no Moneybird project named \"$project_name\" — map \"$punch_project\" in $CONFIG"
      continue
    fi
  fi

  contact_name=$(jq -r '.contact // ""' <<<"$mapping")
  contact_id=""
  if [[ -n $contact_name ]]; then
    if [[ -n ${CONTACT_CACHE[$contact_name]:-} ]]; then
      contact_id=${CONTACT_CACHE[$contact_name]}
    else
      contact_id=$(find_contact_id "$contact_name")
      if [[ -z $contact_id ]]; then
        add_result "" false "no Moneybird contact matches \"$contact_name\""
        continue
      fi
      CONTACT_CACHE[$contact_name]=$contact_id
    fi
  fi

  description=$note
  [[ -n $description ]] || description=$punch_project

  args=(time_entries create
    --user_id "$user_id"
    --started_at "$(date -d "@$start" --iso-8601=seconds)"
    --ended_at "$(date -d "@$end" --iso-8601=seconds)"
    --description "$description"
    --billable "$billable")
  [[ -n $project_id ]] && args+=(--project_id "$project_id")
  [[ -n $contact_id ]] && args+=(--contact_id "$contact_id")

  if ! response=$("$CLI" "${args[@]}" --output raw 2>&1); then
    add_result "" false "$(tr '\n' ' ' <<<"$response" | cut -c1-200)"
    continue
  fi

  moneybird_id=$(jq -r '.id // empty' <<<"$response" 2>/dev/null)
  if [[ -z $moneybird_id ]]; then
    add_result "" false "$(tr '\n' ' ' <<<"$response" | cut -c1-200)"
    continue
  fi

  add_result "$moneybird_id" false ""
done

echo "$results"
